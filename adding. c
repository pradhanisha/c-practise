#include <stdio.h>
int main()
{
    int n,m;
    printf("enter size of both arrays:\n");
    scanf("%d %d",&n,&m);
    int arr[n],brr[m];
    printf("enter elements of first list:\n");
    for(int i=0;i<n;i++)
    {
     scanf("%d",&arr[i]);
    }
    printf("enter elements of second list:\n");
    for(int i=0;i<m;i++)
    {
     scanf("%d",&brr[i]);
    }
    printf("new list:\n");
    for(int i=0;i<n;i++)
    {
     printf("%d  ",arr[i]+brr[i]);
    }
    return 0;
} 
